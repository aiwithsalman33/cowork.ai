# ─────────────────────────────────────────────────────────────
# CoworkAI — environment variables
#
# Local dev:   cp .env.example .env              (docker compose up / npm run dev:api)
# Production:  cp .env.example .env.production   then
#              docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
# ─────────────────────────────────────────────────────────────

# --- Public URL (production) ---
APP_URL=https://coworkai.zenautomations.in
# Port Caddy listens on (point your domain / TLS proxy here)
CADDY_PORT=8080

# --- Database ---
POSTGRES_USER=coworkai
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=coworkai
# Only used when running the api directly on your machine (npm run dev:api):
DATABASE_URL=postgresql://cowork:cowork@localhost:5433/cowork?schema=public

# --- Security (REQUIRED) ---
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# 32 bytes hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Encrypts API keys, bot tokens and Google credentials at rest. Never change it after launch.
ENCRYPTION_KEY=

# --- Local dev URLs (production uses APP_URL for both) ---
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000

# --- First admin (created on boot if missing) ---
ADMIN_EMAIL=aiwithsalman33@gmail.com
ADMIN_PASSWORD=

# --- Email (verification + password reset) ---
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CoworkAI <you@gmail.com>"

# --- WhatsApp ---
WA_GRAPH_VERSION=v21.0
BAILEYS_ENABLED=true
# true = fake AI replies, no provider calls (local dev / load tests only — never in production)
LLM_FAKE=false

# --- Payments (Cashfree) ---
# Keep false until the Cashfree keys are added; users then see "contact us to upgrade".
# Keys: Cashfree dashboard → Payment Gateway → Developers → API Keys. CASHFREE_ENV: sandbox | production
BILLING_ENABLED=false
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2025-01-01
# Legacy (no longer used for checkout)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=

# client → TLS proxy → Caddy → api = 2 hops. Use 1 if Caddy is exposed directly.
TRUST_PROXY=2
LOG_LEVEL=info

# --- Server (defaults are fine for production) ---
NODE_ENV=production
HOST=0.0.0.0
PORT=4000
# Login / signup / password-reset attempts per IP per minute
AUTH_RATE_LIMIT_PER_MIN=5
# Cookie settings: COOKIE_SECURE=false only for plain-http local testing; COOKIE_DOMAIN usually empty
COOKIE_SECURE=true
COOKIE_DOMAIN=
# Background queue and workers (keep true; one API replica only)
QUEUE_ENABLED=true
WORKERS_ENABLED=true
# Where WhatsApp QR sessions are stored (a docker volume in production)
WA_SESSIONS_DIR=/data/wa-sessions
# Local docker only: print emails to the log when SMTP is not set
MAIL_LOG_FALLBACK=false
# Node.js memory caps (MB) for a 1 vCPU / 2 GB VPS
API_MAX_MEMORY_MB=384
WEB_MAX_MEMORY_MB=256

# ---- Off-site backups (backup service; see docs/RUNBOOK.md). Leave empty to keep backups off. ----
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_REGION=auto
BACKUP_S3_PROVIDER=Other
# age public key (age1…); WhatsApp session backups are encrypted with it. Keep the private key offline.
BACKUP_AGE_RECIPIENT=
BACKUP_RETENTION_DAYS=14
# optional uptime-monitor URL pinged after each successful backup
BACKUP_HEARTBEAT_URL=
BACKUP_ON_START=false

# --- Error reporting (Phase 3) ---
# Sentry ingest origin allowed by the web Content-Security-Policy, e.g. https://o123.ingest.sentry.io (build-time)
NEXT_PUBLIC_SENTRY_INGEST=
