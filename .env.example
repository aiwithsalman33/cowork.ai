# ─────────────────────────────────────────────────────────────
# partner.ai — environment variables
# Copy to .env (local dev) or paste into Dokploy → Environment.
# ─────────────────────────────────────────────────────────────

# --- Database (docker compose builds DATABASE_URL for the api from these) ---
POSTGRES_USER=partner
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=partner
# Only used when running the api outside docker (local dev):
DATABASE_URL=postgresql://partner:change-me-strong-password@localhost:5433/partner?schema=public

# --- Security (REQUIRED) ---
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# 32 bytes hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Encrypts API keys, bot tokens and channel credentials at rest. Never change it after launch.
ENCRYPTION_KEY=

# --- Public URLs ---
# Where users open the dashboard (CORS + cookies are locked to this origin)
WEB_ORIGIN=http://localhost:3000
# Public URL of the api service — Telegram / Meta / Razorpay webhooks are sent here
PUBLIC_API_URL=http://localhost:4000
# Optional: share cookies across subdomains, e.g. .example.com
COOKIE_DOMAIN=
# Defaults to true when WEB_ORIGIN is https
COOKIE_SECURE=

# --- First admin (created on boot if missing) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- WhatsApp ---
WA_GRAPH_VERSION=v21.0
BAILEYS_ENABLED=true

# --- Composio (Google integrations via Composio managed OAuth) ---
# Create one "Composio managed" auth config per toolkit in the Composio dashboard and paste the ids.
COMPOSIO_API_KEY=
COMPOSIO_AUTH_CONFIG_GMAIL=
COMPOSIO_AUTH_CONFIG_GOOGLECALENDAR=
COMPOSIO_AUTH_CONFIG_GOOGLESHEETS=
COMPOSIO_AUTH_CONFIG_GOOGLEDRIVE=
COMPOSIO_AUTH_CONFIG_GOOGLEDOCS=
# Optional pins, e.g. COMPOSIO_TOOLKIT_VERSION_GMAIL=20251027_00 (otherwise latest is used)

# --- Razorpay (INR subscriptions) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Plan ids created in Razorpay Dashboard → Subscriptions → Plans (₹999/month and ₹2,999/month)
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=

LOG_LEVEL=info
