# Local development image (hot reload). Used by docker-compose.yml for both api and web;
# the source is bind-mounted, node_modules stay inside the container.
FROM node:24-alpine
RUN apk add --no-cache openssl libc6-compat
WORKDIR /app
ENV NPM_CONFIG_UPDATE_NOTIFIER=false NPM_CONFIG_FUND=false NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/shared/package.json packages/shared/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN --mount=type=cache,target=/root/.npm npm ci
COPY apps/api/prisma apps/api/prisma
RUN cd apps/api && npx prisma generate
