{
  "name": "partner-ai",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": { "node": ">=22.22.3" },
  "scripts": {
    "build": "pnpm -r --filter ./packages/** build && pnpm -r --filter ./apps/** build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm --filter @partner/api test",
    "test:e2e": "pnpm --filter @partner/web test:e2e",
    "dev:api": "pnpm --filter @partner/api dev",
    "dev:web": "pnpm --filter @partner/web dev",
    "db:migrate": "pnpm --filter @partner/api prisma:migrate",
    "db:seed": "pnpm --filter @partner/api seed"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@prisma/client", "@prisma/engines", "prisma", "esbuild", "sharp", "protobufjs", "argon2"]
  }
}
