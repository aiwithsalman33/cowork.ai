{
  "name": "cowork-ai",
  "private": true,
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build": "npm run build -w @cowork/shared && npm run build -w @cowork/api && npm run build -w @cowork/web",
    "build:shared": "npm run build -w @cowork/shared",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm test -w @cowork/api",
    "test:e2e": "npm run test:e2e -w @cowork/web",
    "dev:api": "npm run dev -w @cowork/api",
    "dev:web": "npm run dev -w @cowork/web",
    "db:migrate": "npm run prisma:migrate -w @cowork/api",
    "db:deploy": "npm run prisma:deploy -w @cowork/api",
    "db:seed": "npm run seed -w @cowork/api",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "allowScripts": {
    "prisma": true,
    "@prisma/engines": true,
    "esbuild": true,
    "protobufjs": true,
    "@prisma/client": true,
    "baileys": true
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "prettier --write",
      "eslint --fix --no-warn-ignored"
    ],
    "*.{json,md,yml,yaml,css}": "prettier --write"
  }
}
