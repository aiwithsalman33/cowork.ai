{
  "name": "partner-ai",
  "private": true,
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build": "npm run build -w @partner/shared && npm run build -w @partner/api && npm run build -w @partner/web",
    "build:shared": "npm run build -w @partner/shared",
    "typecheck": "npm run build:shared && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm test -w @partner/api",
    "test:e2e": "npm run test:e2e -w @partner/web",
    "dev:api": "npm run dev -w @partner/api",
    "dev:web": "npm run dev -w @partner/web",
    "db:migrate": "npm run prisma:migrate -w @partner/api",
    "db:deploy": "npm run prisma:deploy -w @partner/api",
    "db:seed": "npm run seed -w @partner/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "allowScripts": {
    "prisma": true,
    "@prisma/engines": true,
    "esbuild": true,
    "protobufjs": true,
    "@prisma/client": true,
    "baileys": true
  }
}
